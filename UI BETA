	opts = opts or {}
	local lib = self.page.library
	local items = list or {}
	local selected, open, focused = nil, false, false
	local ITEM_H, GAP = 26, 3
	local defaultTip, tipMap, hoverBtn = nil, {}, nil -- addTip state (tips show while hovering items)

	local holder = lib:_new("Frame", {
		Name = "Dropdown",
		Size = UDim2.new(1, 0, 0, 32),
