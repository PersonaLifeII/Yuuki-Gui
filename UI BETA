		Size = UDim2.new(1, 0, 0, 32),
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		Parent = self.container,
	})

	local header = self:_row("Header", 32, holder)
	local label = self:_label(header, title, -100)

	local spinBtn = lib:_new("TextButton", {
		Name = "Spin",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -8, 0.5, 0),
		Size = UDim2.fromOffset(70, 22),
		Text = "SPIN",
		TextSize = 11,
		AutoButtonColor = false,
		_font = "Title",
		_theme = { BackgroundColor3 = "Accent", TextColor3 = "Background" },
		Parent = header,
	}, { lib:_corner(6) })

	local panel = lib:_new("Frame", {
		Name = "Panel",
		Position = UDim2.fromOffset(0, 36),
		Size = UDim2.new(1, 0, 0, PANEL_H),
		_theme = { BackgroundColor3 = "Background" },
		Parent = holder,
	}, {
		lib:_corner(7),
		lib:_new("UIStroke", { Thickness = 1, Transparency = 0.6, _theme = { Color = "Stroke" } }),
	})

	local wheelGroup = lib:_new("CanvasGroup", {
		Name = "WheelDisc",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 16),
		Size = UDim2.fromOffset(WHEEL, WHEEL),
		BackgroundTransparency = 1,
		Parent = panel,
	}, { lib:_corner(99) })

	local slices = lib:_new("Frame", {
		Name = "Slices",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Parent = wheelGroup,
	})

	lib:_new("Frame", {
		Name = "Ring",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 16),
		Size = UDim2.fromOffset(WHEEL, WHEEL),
		BackgroundTransparency = 1,
		Parent = panel,
	}, {
		lib:_corner(99),
		lib:_new("UIStroke", { Thickness = 3, _theme = { Color = "Accent" } }),
	})

	local hub = lib:_new("Frame", {
		Name = "Hub",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0, 16 + R),
		Size = UDim2.fromOffset(24, 24),
		BorderSizePixel = 0,
		_theme = { BackgroundColor3 = "Background" },
		Parent = panel,
	}, {
		lib:_corner(99),
		lib:_new("UIStroke", { Thickness = 2, _theme = { Color = "Accent" } }),
	})

	local pointer = lib:_new("Frame", {
		Name = "Pointer",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0, 13),
		Size = UDim2.fromOffset(14, 14),
		Rotation = 45,
		BorderSizePixel = 0,
		_theme = { BackgroundColor3 = "Accent" },
		Parent = panel,
	}, {
		lib:_corner(3),
		lib:_new("UIStroke", { Thickness = 2, _theme = { Color = "Background" } }),
	})

	local resultLabel = lib:_new("TextLabel", {
		Name = "Result",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(8, 162),
		Size = UDim2.new(1, -16, 0, 20),
		Text = "Press SPIN!",
		TextSize = 14,
		TextTruncate = Enum.TextTruncate.AtEnd,
		_font = "Title",
		_theme = { TextColor3 = "Accent" },
		Parent = panel,
	})

	local againBtn = lib:_new("TextButton", {
		Name = "Again",
		Position = UDim2.fromOffset(8, 186),
		Size = UDim2.new(0.5, -12, 0, 24),
		Text = "Spin again",
		TextSize = 12,
		AutoButtonColor = false,
		_font = "Body",
		_theme = { BackgroundColor3 = "Element", TextColor3 = "Text" },
		Parent = panel,
	}, { lib:_corner(6) })

	local closeBtn = lib:_new("TextButton", {
		Name = "Close",
		Position = UDim2.new(0.5, 4, 0, 186),
		Size = UDim2.new(0.5, -12, 0, 24),
		Text = "Close",
		TextSize = 12,
		AutoButtonColor = false,
		_font = "Body",
		_theme = { BackgroundColor3 = "Element", TextColor3 = "SubText" },
		Parent = panel,
	}, { lib:_corner(6) })

	local function colorFor(idx, n)
		local ci = (idx - 1) % #WHEEL_HEX + 1
		if idx == n and n > 1 and ci == 1 then
			ci = 2 -- avoid the last slice matching the first
		end
		return hex(WHEEL_HEX[ci])
	end

	-- the disc is drawn from thin rotated bars (clipped to a circle by the CanvasGroup)
	local function build()
		slices:ClearAllChildren()
		local n = #options
		if n == 0 then
			return
		end

		local seg = 360 / n
		local bars = 180
		local step = 360 / bars
		local len = R + 8

		for i = 0, bars - 1 do
			local mid = i * step + step / 2
			local idx = math.min(math.floor(mid / seg) + 1, n)
			local rad = math.rad(mid)
			local mr = len / 2
			lib:_new("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromOffset(R + math.sin(rad) * mr, R - math.cos(rad) * mr),
				Size = UDim2.fromOffset(5, len),
				Rotation = mid,
				BorderSizePixel = 0,
				BackgroundColor3 = colorFor(idx, n),
				Parent = slices,
			})
		end

		if n > 1 then
			for i = 1, n do
				local ang = (i - 1) * seg
				local rad = math.rad(ang)
				local mr = (R + 2) / 2
				lib:_new("Frame", {
					AnchorPoint = Vector2.new(0.5, 0.5),
					Position = UDim2.fromOffset(R + math.sin(rad) * mr, R - math.cos(rad) * mr),
					Size = UDim2.fromOffset(2, R + 2),
					Rotation = ang,
					BorderSizePixel = 0,
					BackgroundColor3 = lib.theme.Background,
					Parent = slices,
				})
			end
		end

		if n <= 14 then
			for idx = 1, n do
				local mid = (idx - 0.5) * seg
				local rad = math.rad(mid)
				local rr = R * 0.62
				lib:_new("TextLabel", {
					AnchorPoint = Vector2.new(0.5, 0.5),
					Position = UDim2.fromOffset(R + math.sin(rad) * rr, R - math.cos(rad) * rr),
					Size = UDim2.fromOffset(math.floor(R * 0.62), 14),
					Rotation = mid - 90,
					BackgroundTransparency = 1,
					Text = tostring(options[idx]),
					TextScaled = true,
					Font = Enum.Font.GothamBold,
					TextColor3 = Color3.fromRGB(30, 36, 34),
					Parent = slices,
				}, {
					lib:_new("UITextSizeConstraint", { MaxTextSize = 11, MinTextSize = 5 }),
				})
			end
		end
	end

	local obj = { Instance = holder }

	local function setOpen(state)
		open = state
		tw(holder, { Size = UDim2.new(1, 0, 0, state and (36 + PANEL_H) or 32) }, 0.3)
	end

	local lastKick = 0
	local function kick()
		local now = os.clock()
		if now - lastKick < 0.03 then
			return
		end
		lastKick = now
		pointer.Rotation = 70
		tw(pointer, { Rotation = 45 }, 0.12)
	end

	local function spin()
		local n = #options
		if spinning or n == 0 then
			return
		end
		spinning = true
		spinBtn.Text = "..."
		resultLabel.Text = "Spinning..."

		local seg = 360 / n
		local pick = rng:NextInteger(1, n)
		local jitter = rng:NextNumber(-0.38, 0.38) * seg
		-- the pointer sits at the top; rotate so the picked slice ends up beneath it
		local targetMod = (-((pick - 0.5) * seg + jitter)) % 360
		local delta = (targetMod - rot) % 360 + 360 * rng:NextInteger(5, 7)

		local startRot = rot
		local startTime = os.clock()
		local duration = 5
		local lastTick = math.floor(-startRot / seg)

		local conn
		conn = RunService.Heartbeat:Connect(function()
			local t = math.clamp((os.clock() - startTime) / duration, 0, 1)
			local eased = 1 - (1 - t) ^ 4
			local current = startRot + delta * eased
			wheelGroup.Rotation = current % 360

			local tickIdx = math.floor(-current / seg)
			if tickIdx ~= lastTick then
				lastTick = tickIdx
				kick()
			end

			if t >= 1 then
				conn:Disconnect()
				rot = (startRot + delta) % 360
				spinning = false
				spinBtn.Text = "SPIN"
				lastResult = options[pick]
				resultLabel.Text = tostring(lastResult)
				resultLabel.TextSize = 20
				tw(resultLabel, { TextSize = 14 }, 0.4, Enum.EasingStyle.Back)
				hub.Size = UDim2.fromOffset(34, 34)
				tw(hub, { Size = UDim2.fromOffset(24, 24) }, 0.4, Enum.EasingStyle.Back)
				if callback then
					task.spawn(callback, lastResult, pick, obj)
				end
			end
		end)
		table.insert(lib.conns, conn)
	end

	local function request()
		if spinning then
			return
		end
		if not open then
			setOpen(true)
			spinning = true -- block double clicks while the panel opens
			task.delay(0.3, function()
				spinning = false
				spin()
			end)
		else
			spin()
		end
	end

	spinBtn.MouseButton1Click:Connect(request)
	againBtn.MouseButton1Click:Connect(function()
		if open then
			spin()
		end
	end)
	closeBtn.MouseButton1Click:Connect(function()
		setOpen(false)
	end)

	function obj:Spin()
		request()
	end
	function obj:Get()
		return lastResult
	end
	function obj:SetOptions(list)
		options = list or {}
		lastResult = nil
		resultLabel.Text = "Press SPIN!"
		build()
	end
	function obj:SetTitle(text)
		label.Text = text
	end

	build()
	return obj
end

--------------------------------------------------------------------------
-- ready-made settings page
--------------------------------------------------------------------------

function Library:addSettingsPage()
	local page = self:addPage("Settings", "設", "設定")

	local ui = page:addSection("Interface")
	ui:addKeybind("Toggle UI", self.toggleKey, nil, function(key, obj)
		if key then
			self.toggleKey = key
		else
			obj:Set(Enum.KeyCode.RightControl) -- never leave the UI without a toggle key
		end
	end)
	ui:addToggle("Sakura petals", true, function(value)
		self:setPetals(value)
	end)
	ui:addToggle("Floating toggle button", self.floatBtn.Visible, function(value)
		self.floatBtn.Visible = value
	end)
	ui:addSlider("Window opacity", 100, 40, 100, function(value)
		self.bg.BackgroundTransparency = 1 - value / 100
	end)
	ui:addDropdown("Font", { "Nunito", "Gotham", "Jura", "Michroma", "Kalam", "SourceSans", "Code" }, function(name)
		self:setFont(name)
	end)
	ui:addButton("Reset window size", function()
		self:resetSize()
	end)
	ui:addButton("Unload UI", function()
		self:Destroy()
	end)

	local theme = page:addSection("Theme  ·  テーマ")
	local pickers = {}

	local presets = {
		["Sakura Mint"] = "BDFFD7",
		["Sakura Pink"] = "FFB7D5",
		["Sky Blue"] = "A8D8FF",
		["Wisteria"] = "D5B8FF",
		["Sunset"] = "FFC49B",
		["Matcha"] = "B8E986",
	}
	local presetNames = { "Sakura Mint", "Sakura Pink", "Sky Blue", "Wisteria", "Sunset", "Matcha" }

	theme:addDropdown("Accent preset", presetNames, function(name)
		local color = hex(presets[name])
		self:setTheme("Accent", color)
		pickers.Accent:Set(color, true)
	end)

	for _, key in ipairs({ "Accent", "Background", "Panel", "Element", "Text" }) do
		pickers[key] = theme:addColorPicker(key, self.theme[key], function(color)
			self:setTheme(key, color)
		end)
	end

	theme:addButton("Reset theme", function()
		for key, color in pairs(DEFAULT_THEME) do
			self:setTheme(key, color)
			if pickers[key] then
				pickers[key]:Set(color, true)
			end
		end
	end)

	return page
end

return Library
