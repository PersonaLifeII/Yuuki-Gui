		if listening then
			if input.UserInputType == Enum.UserInputType.Keyboard then
				if input.KeyCode == Enum.KeyCode.Escape then
					obj:Set(nil)
				else
					obj:Set(input.KeyCode)
				end
			end
			return
		end
		if key and not processed and input.KeyCode == key and callback then
			task.spawn(callback, obj)
		end
	end)

	return obj
end

