	})

	local input = lib:_new("TextBox", {
		Name = "Input",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(6, 0),
		Size = UDim2.new(1, -12, 1, 0),
		Text = default or "",
		PlaceholderText = "type here...",
		ClearTextOnFocus = false,
		TextSize = 12,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextXAlignment = Enum.TextXAlignment.Left,
		_font = "Body",
		_theme = { TextColor3 = "Text", PlaceholderColor3 = "SubText" },
		Parent = boxFrame,
	})

	local obj = { Instance = row }
	function obj:Set(text, silent)
		input.Text = tostring(text)
		if not silent and callback then
			task.spawn(callback, input.Text, false, obj)
		end
	end
	function obj:Get()
		return input.Text
