--[[
	NovaUI - ModuleScript
	Put this in ReplicatedStorage as a ModuleScript named "NovaUI".
	Then require it from a LocalScript (see NovaUI_Example.lua).

	API
	  local Window = NovaUI.new("Title")
	  local Tab    = Window:AddTab("Name", "CATEGORY", "icon text")
	  local Section = Tab:AddSection("Section name", "left" | "right")
	  Section:AddToggle(name, default, callback, {Description = "...", Keybind = Enum.KeyCode.F1 or true})
	  Section:AddSlider(name, min, max, default, callback)
	  Section:AddButton(name, callback)
	  Section:AddDropdown(name, {"a","b"}, default, callback)
	  Section:AddLabel(text)
	  Window:Notify(title, text, seconds)
	  Window:SetToggleKey(Enum.KeyCode.RightShift)
	  Window:Destroy()
]]

local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer

local Theme = {
	Background = Color3.fromRGB(14, 12, 14),
	Sidebar = Color3.fromRGB(18, 15, 17),
	Section = Color3.fromRGB(22, 18, 20),
	Row = Color3.fromRGB(34, 28, 31),
	Off = Color3.fromRGB(44, 40, 43),
	Accent = Color3.fromRGB(255, 82, 82),
	Text = Color3.fromRGB(235, 235, 235),
	SubText = Color3.fromRGB(130, 125, 128),
	Stroke = Color3.fromRGB(38, 32, 35),
}

local FONT = Enum.Font.GothamMedium
local FONT_BOLD = Enum.Font.GothamBold

local function new(class, props, parent)
	local obj = Instance.new(class)
	for k, v in pairs(props or {}) do
		obj[k] = v
	end
	obj.Parent = parent
	return obj
end

local function corner(parent, radius)
	return new("UICorner", {CornerRadius = UDim.new(0, radius or 6)}, parent)
end

local function tween(obj, props, time)
	TweenService:Create(obj, TweenInfo.new(time or 0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play()
end

local function label(parent, props)
	local base = {
		BackgroundTransparency = 1,
		Font = FONT,
		TextSize = 13,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = "",
	}
	for k, v in pairs(props) do
		base[k] = v
	end
	return new("TextLabel", base, parent)
end

local Library = {}
Library.__index = Library
local Tab = {}
Tab.__index = Tab
local Section = {}
Section.__index = Section

--------------------------------------------------------------------
-- Window
--------------------------------------------------------------------
function Library.new(title)
	local self = setmetatable({}, Library)
	self.Tabs = {}
	self.ToggleKey = Enum.KeyCode.RightShift
	self._lastCategory = nil
	self._order = 0
	self._connections = {}

	local gui = new("ScreenGui", {
		Name = "NovaUI_" .. tostring(title),
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		IgnoreGuiInset = true,
	})
	-- PlayerGui works in Roblox Studio (CoreGui does not for normal scripts)
	gui.Parent = player:WaitForChild("PlayerGui")
	self.Gui = gui

	local main = new("Frame", {
		Name = "Main",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 0),
		Size = UDim2.new(0, 780, 0, 500),
		BackgroundColor3 = Theme.Background,
		BorderSizePixel = 0,
	}, gui)
	corner(main, 10)
	new("UIStroke", {Color = Theme.Stroke, Thickness = 1}, main)
	self.Main = main

	-- Sidebar
	local sidebar = new("Frame", {
		Name = "Sidebar",
		Size = UDim2.new(0, 180, 1, 0),
		BackgroundColor3 = Theme.Sidebar,
		BorderSizePixel = 0,
	}, main)
	corner(sidebar, 10)
	-- square off the right edge of the sidebar
	new("Frame", {
		Position = UDim2.new(1, -10, 0, 0),
		Size = UDim2.new(0, 10, 1, 0),
		BackgroundColor3 = Theme.Sidebar,
		BorderSizePixel = 0,
	}, sidebar)

	label(sidebar, {
		Name = "Logo",
		Size = UDim2.new(1, 0, 0, 70),
		Text = string.upper(string.sub(tostring(title), 1, 1)),
		Font = Enum.Font.GothamBlack,
		TextSize = 40,
		TextColor3 = Theme.Accent,
		TextXAlignment = Enum.TextXAlignment.Center,
	})

	local tabList = new("ScrollingFrame", {
		Name = "TabList",
		Position = UDim2.new(0, 0, 0, 74),
		Size = UDim2.new(1, 0, 1, -130),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 0,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
	}, sidebar)
	new("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 4)}, tabList)
	new("UIPadding", {PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10)}, tabList)
	self.TabList = tabList

	label(sidebar, {
		Position = UDim2.new(0, 14, 1, -46),
		Size = UDim2.new(1, -28, 0, 16),
		Text = player.Name,
		Font = FONT_BOLD,
		TextSize = 12,
	})
	label(sidebar, {
		Position = UDim2.new(0, 14, 1, -30),
		Size = UDim2.new(1, -28, 0, 14),
		Text = tostring(title),
		TextSize = 10,
		TextColor3 = Theme.SubText,
	})

	-- Top bar / search
	local topbar = new("Frame", {
		Name = "TopBar",
		Position = UDim2.new(0, 180, 0, 0),
		Size = UDim2.new(1, -180, 0, 60),
		BackgroundTransparency = 1,
	}, main)

	local searchBox = new("Frame", {
		Position = UDim2.new(0, 16, 0, 14),
		Size = UDim2.new(0, 300, 0, 34),
		BackgroundColor3 = Theme.Section,
		BorderSizePixel = 0,
	}, topbar)
	corner(searchBox, 8)
	new("UIStroke", {Color = Theme.Stroke}, searchBox)
	label(searchBox, {
		Position = UDim2.new(0, 10, 0, 0),
		Size = UDim2.new(0, 20, 1, 0),
		Text = "🔍",
		TextSize = 12,
	})
	local search = new("TextBox", {
		Position = UDim2.new(0, 34, 0, 0),
		Size = UDim2.new(1, -44, 1, 0),
		BackgroundTransparency = 1,
		Font = FONT,
		TextSize = 13,
		TextColor3 = Theme.Text,
		PlaceholderText = "Search...",
		PlaceholderColor3 = Theme.SubText,
		Text = "",
		ClearTextOnFocus = false,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, searchBox)
	search:GetPropertyChangedSignal("Text"):Connect(function()
		self:_filter(search.Text)
	end)

	-- Pages area
	self.Pages = new("Frame", {
		Name = "Pages",
		Position = UDim2.new(0, 196, 0, 62),
		Size = UDim2.new(1, -208, 1, -74),
		BackgroundTransparency = 1,
		ClipsDescendants = true,
	}, main)

	-- Dragging (by top bar and sidebar logo)
	local function makeDraggable(handle)
		local dragging, dragStart, startPos
		handle.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				dragStart = input.Position
				startPos = main.Position
				input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then
						dragging = false
					end
				end)
			end
		end)
		table.insert(self._connections, UIS.InputChanged:Connect(function(input)
			if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
				local delta = input.Position - dragStart
				main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
			end
		end))
	end
	makeDraggable(topbar)
	makeDraggable(sidebar.Logo)

	-- Toggle visibility key
	table.insert(self._connections, UIS.InputBegan:Connect(function(input, processed)
		if processed then return end
		if input.KeyCode == self.ToggleKey then
			gui.Enabled = not gui.Enabled
		end
	end))

	-- Notifications holder
	self.NotifyHolder = new("Frame", {
		Name = "Notifications",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -16, 1, -16),
		Size = UDim2.new(0, 260, 1, -32),
		BackgroundTransparency = 1,
	}, gui)
	new("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		VerticalAlignment = Enum.VerticalAlignment.Bottom,
		Padding = UDim.new(0, 8),
	}, self.NotifyHolder)

	return self
end

function Library:SetToggleKey(key)
	self.ToggleKey = key
end

function Library:Destroy()
	for _, c in ipairs(self._connections) do
		c:Disconnect()
	end
	self.Gui:Destroy()
end

function Library:_filter(text)
	text = string.lower(text or "")
	local page = self.Selected
	if not page then return end
	for _, entry in ipairs(page.Elements) do
		entry.frame.Visible = text == "" or string.find(string.lower(entry.name), text, 1, true) ~= nil
	end
end

function Library:Notify(title, text, seconds)
	local card = new("Frame", {
		Size = UDim2.new(1, 0, 0, 56),
		BackgroundColor3 = Theme.Section,
		BorderSizePixel = 0,
		LayoutOrder = tick() * 1000 % 100000,
	}, self.NotifyHolder)
	corner(card, 8)
	new("UIStroke", {Color = Theme.Accent, Transparency = 0.5}, card)
	label(card, {
		Position = UDim2.new(0, 12, 0, 8),
		Size = UDim2.new(1, -24, 0, 18),
		Text = tostring(title),
		Font = FONT_BOLD,
		TextSize = 13,
		TextColor3 = Theme.Accent,
	})
	label(card, {
		Position = UDim2.new(0, 12, 0, 28),
		Size = UDim2.new(1, -24, 0, 20),
		Text = tostring(text or ""),
		TextSize = 12,
		TextColor3 = Theme.SubText,
	})
	task.delay(seconds or 3, function()
		if card.Parent then
			card:Destroy()
		end
	end)
end

