-- player lookup helpers (mode 2) ------------------------------------------

function Library:_findPlayer(query)
	if typeof(query) == "Instance" then
		return query:IsA("Player") and query or nil
	end
	if type(query) == "number" then
		return Players:GetPlayerByUserId(query)
	end
	if type(query) ~= "string" then
		return nil
	end
	local q = query:lower()
	for _, p in ipairs(Players:GetPlayers()) do
		if p.Name:lower() == q or p.DisplayName:lower() == q then
			return p
		end
	end
	return nil
end

-- returns a Player (in this server), a username string / userId number (needs a lookup), or nil
function Library:_playerTarget(arg, ctx)
	local isFunction = type(arg) == "function" -- a function that returns nil means "nobody", not "guess from the text"
	arg = resolveArg(arg, ctx)

	if arg == nil and not isFunction then
		if type(ctx) ~= "string" then
			return nil
		end
		local text = (ctx:gsub("<[^>]+>", ""))
		local lower = text:lower()

		-- 1) a player in this server whose name appears in the text (longest match wins)
		local best, bestLen
		for _, p in ipairs(Players:GetPlayers()) do
			for _, n in ipairs({ p.Name, p.DisplayName }) do
				if #n >= 3 and lower:find(n:lower(), 1, true) and (not bestLen or #n > bestLen) then
					best, bestLen = p, #n
				end
			end
		end
		if best then
			return best
		end

		-- 2) otherwise treat whatever follows the last ":" as a username
		local candidate = text:match("([^:]*)$") or text
		candidate = candidate:gsub("^%s+", ""):gsub("%s+$", "")
		if #candidate >= 3 and #candidate <= 20 and candidate:match("^[%w_]+$") then
			return candidate
		end
		return nil
	end

	if arg == nil then
		return nil
	end

	local p = self:_findPlayer(arg)
	if p then
		return p
	end
	if type(arg) == "string" or type(arg) == "number" then
		return arg
	end
	return nil
end

-- turns a target into something showAvatar can use (may yield)
function Library:_userFrom(target)
	if typeof(target) == "Instance" then
		return target
	end

	local key = tostring(target):lower()
	local cached = self.userCache[key]
	if cached ~= nil then
		return cached or nil
	end

	local ok, id, name
	if type(target) == "number" then
		id = target
		ok, name = pcall(function()
			return Players:GetNameFromUserIdAsync(target)
		end)
		if not ok then
			name = tostring(target)
		end
	else
		ok, id = pcall(function()
			return Players:GetUserIdFromNameAsync(target)
		end)
		name = target
		if not ok then
			id = nil
		end
	end

	if id then
		local user = { Name = name, DisplayName = name, UserId = id }
		self.userCache[key] = user
		return user
	end
	self.userCache[key] = false
	return nil
end

