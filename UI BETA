--------------------------------------------------------------------------

local TipMT = {}
TipMT.__call = function(self, ...)
	return setmetatable({ _isTip = true, mode = self.mode, args = table.pack(...) }, TipMT)
end
TipMT.__tostring = function(self)
	return "addTip[" .. tostring(self.mode) .. "]"
end

local function newTip(mode, ...)
	return setmetatable({ _isTip = true, mode = mode, args = table.pack(...) }, TipMT)
end

local function isTip(v)
	return type(v) == "table" and rawget(v, "_isTip") == true
end

-- accepts: a tip descriptor, a mode number + its arguments, or a plain string (= tooltip text)
local function toTip(a, ...)
	if isTip(a) then
		if select("#", ...) > 0 then
			return newTip(a.mode, ...)
		end
		return a
	elseif type(a) == "number" and a >= 1 and a <= 3 and math.floor(a) == a then
		return newTip(a, ...)
	elseif type(a) == "string" then
		return newTip(1, a, ...)
	end
	return nil
end

local function resolveArg(v, ctx)
	if type(v) == "function" then
		local ok, result = pcall(v, ctx)
		if ok then
			return result
		end
		return nil
	end
	return v
end

local function toImage(id)
	if id == nil or id == "" then
		return nil
	end
	if type(id) == "number" then
		return "rbxassetid://" .. tostring(id)
	end
	id = tostring(id)
	if id:match("^%d+$") then
		return "rbxassetid://" .. id
	end
	return id
end

local function mousePos()
	return UserInputService:GetMouseLocation() - GuiService:GetGuiInset()
end

local function pointIn(gui, p)
	local a, s = gui.AbsolutePosition, gui.AbsoluteSize
	return p.X >= a.X and p.X <= a.X + s.X and p.Y >= a.Y and p.Y <= a.Y + s.Y
end

-- is `gui` visible and not clipped away at point p?
local function shownAt(gui, p)
	local cur = gui
	while cur and not cur:IsA("LayerCollector") do
		if cur:IsA("GuiObject") then
			if not cur.Visible then
				return false
			end
			if cur ~= gui and (cur.ClipsDescendants or cur:IsA("ScrollingFrame") or cur:IsA("CanvasGroup")) then
				if not pointIn(cur, p) then
					return false
				end
			end
		end
		cur = cur.Parent
	end
	return cur ~= nil
end

Library.addTip = { newTip(1), newTip(2), newTip(3) }

-- elements register a hover area; popups (dropdown lists, pickers…) register as occluders
function Library:_registerTip(gui, tip, getText)
