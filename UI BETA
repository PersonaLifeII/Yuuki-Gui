function Library:toggle(force)
	local show = force
	if show == nil then
		show = not self.visible
	end
	if show == self.visible then
		return
	end

	self.visible = show
	self._tok = (self._tok or 0) + 1
	local tok = self._tok

	if show then
		self.root.Visible = true
		tw(self.scale, { Scale = 1 }, 0.3, Enum.EasingStyle.Back)
		tw(self.window, { GroupTransparency = 0 }, 0.25)
	else
		tw(self.scale, { Scale = 0.92 }, 0.2)
		tw(self.window, { GroupTransparency = 1 }, 0.2)
		task.delay(0.22, function()
			if self._tok == tok and not self.visible then
				self.root.Visible = false
			end
		end)
	end
end

function Library:setToggleKey(key)
	self.toggleKey = key
end

function Library:setPetals(state)
	self.petalsEnabled = state and true or false
	self.petalsFrame.Visible = self.petalsEnabled
end

function Library:setTheme(key, color)
	self.theme[key] = color
	for i = #self.themed, 1, -1 do
		local entry = self.themed[i]
		if not entry.obj.Parent then
			table.remove(self.themed, i)
		else
			for prop, k in pairs(entry.map) do
				if k == key then
					tw(entry.obj, { [prop] = color }, 0.25)
				end
			end
		end
	end
	for _, fn in ipairs(self.binds) do
		fn()
	end
end

function Library:setFont(name)
	local ok, font = pcall(function()
		return Enum.Font[name]
	end)
	if not ok or not font then
		return
	end
	self.fonts.Body = font
	for _, entry in ipairs(self.fontObjs) do
		if entry.key == "Body" and entry.obj.Parent then
			entry.obj.Font = font
		end
	end
end

-- drag any edge / corner of the window to resize it
function Library:_makeResizer()
	local root = self.root
	local MIN_W, MIN_H, MAX_W, MAX_H = 470, 330, 1000, 760

	-- name, position, size, dx, dy
	local defs = {
		{ "Right", UDim2.new(1, -3, 0, 12), UDim2.new(0, 8, 1, -24), 1, 0 },
		{ "Left", UDim2.new(0, -5, 0, 12), UDim2.new(0, 8, 1, -24), -1, 0 },
		{ "Bottom", UDim2.new(0, 12, 1, -3), UDim2.new(1, -24, 0, 8), 0, 1 },
		{ "Top", UDim2.new(0, 12, 0, -5), UDim2.new(1, -24, 0, 8), 0, -1 },
		{ "BottomRight", UDim2.new(1, -9, 1, -9), UDim2.fromOffset(18, 18), 1, 1 },
		{ "BottomLeft", UDim2.new(0, -9, 1, -9), UDim2.fromOffset(18, 18), -1, 1 },
		{ "TopRight", UDim2.new(1, -9, 0, -9), UDim2.fromOffset(18, 18), 1, -1 },
		{ "TopLeft", UDim2.new(0, -9, 0, -9), UDim2.fromOffset(18, 18), -1, -1 },
	}

	local active

	for _, d in ipairs(defs) do
		local handle = self:_new("Frame", {
			Name = "Resize" .. d[1],
			Position = d[2],
			Size = d[3],
			BackgroundTransparency = 1,
			Active = true,
			Parent = root,
		})
		local glow = self:_new("Frame", {
			Name = "Glow",
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			_theme = { BackgroundColor3 = "Accent" },
			Parent = handle,
		}, { self:_corner(99) })

		handle.MouseEnter:Connect(function()
			if not active then
				tw(glow, { BackgroundTransparency = 0.6 }, 0.12)
			end
		end)
		handle.MouseLeave:Connect(function()
			if not active or active.glow ~= glow then
				tw(glow, { BackgroundTransparency = 1 }, 0.15)
			end
		end)
		handle.InputBegan:Connect(function(input)
			if isPress(input) then
				active = {
					glow = glow,
					dx = d[4],
					dy = d[5],
					mouse = input.Position,
					w = root.Size.X.Offset,
					h = root.Size.Y.Offset,
					pos = root.Position,
				}
				glow.BackgroundTransparency = 0.4
			end
		end)
	end

	self:_connect(UserInputService.InputChanged, function(input)
		if not active or not isMove(input) then
			return
		end
		local delta = input.Position - active.mouse
		local w = active.dx ~= 0 and math.clamp(active.w + active.dx * delta.X, MIN_W, MAX_W) or active.w
		local h = active.dy ~= 0 and math.clamp(active.h + active.dy * delta.Y, MIN_H, MAX_H) or active.h
		root.Size = UDim2.fromOffset(w, h)
		-- root is center-anchored, so shift it by half the size change to keep the opposite edge fixed
		root.Position = UDim2.new(
			active.pos.X.Scale,
			active.pos.X.Offset + active.dx * (w - active.w) / 2,
			active.pos.Y.Scale,
			active.pos.Y.Offset + active.dy * (h - active.h) / 2
		)
	end)

	self:_connect(UserInputService.InputEnded, function(input)
		if active and isPress(input) then
			tw(active.glow, { BackgroundTransparency = 1 }, 0.2)
			active = nil
		end
	end)
end

function Library:setSize(width, height)
	self.root.Size = UDim2.fromOffset(width, height)
end

function Library:resetSize()
	tw(self.root, { Size = self.defaultSize }, 0.3)
end

-- avatar preview panel (shown to the right of the window by addPlayers)
function Library:_getAvatarPanel()
	if self.avatar then
		return self.avatar
	end

	local panel = self:_new("CanvasGroup", {
		Name = "AvatarPanel",
		Position = UDim2.new(1, 26, 0, 0),
		Size = UDim2.fromOffset(180, 226),
		GroupTransparency = 1,
		Visible = false,
		_theme = { BackgroundColor3 = "Panel" },
		Parent = self.root,
	}, { self:_corner(12) })

	self:_new("TextLabel", {
		Name = "Heading",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, 9),
		Size = UDim2.new(1, 0, 0, 14),
		Text = "プレイヤー  ·  PLAYER",
		TextSize = 10,
		Font = Enum.Font.Gotham,
		_theme = { TextColor3 = "SubText" },
		Parent = panel,
	})

	local image = self:_new("ImageLabel", {
		Name = "Avatar",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 30),
		Size = UDim2.fromOffset(140, 140),
		BorderSizePixel = 0,
		ScaleType = Enum.ScaleType.Fit,
		_theme = { BackgroundColor3 = "Element" },
		Parent = panel,
	}, { self:_corner(12) })

	local nameLabel = self:_new("TextLabel", {
		Name = "DisplayName",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(8, 176),
		Size = UDim2.new(1, -16, 0, 20),
		TextSize = 15,
		TextTruncate = Enum.TextTruncate.AtEnd,
		_font = "Title",
		_theme = { TextColor3 = "Accent" },
		Parent = panel,
	})

	local userLabel = self:_new("TextLabel", {
		Name = "Username",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(8, 197),
		Size = UDim2.new(1, -16, 0, 16),
		TextSize = 12,
		TextTruncate = Enum.TextTruncate.AtEnd,
		_font = "Body",
		_theme = { TextColor3 = "SubText" },
		Parent = panel,
	})

	self:_new("Frame", {
		Name = "Outline",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Parent = panel,
	}, {
		self:_corner(12),
		self:_new("UIStroke", {
			Thickness = 2,
			Transparency = 0.5,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
			_theme = { Color = "Accent" },
		}),
	})

	self.avatar = { panel = panel, image = image, name = nameLabel, user = userLabel }
	return self.avatar
end

function Library:showAvatar(plr)
	if not plr then
		return
	end

	local a = self:_getAvatarPanel()
	self._avatarToken = (self._avatarToken or 0) + 1
	local tok = self._avatarToken

	a.name.Text = plr.DisplayName
	a.user.Text = "@" .. plr.Name

	if not a.panel.Visible then
		a.panel.Position = UDim2.new(1, 26, 0, 0)
	end
	a.panel.Visible = true
	tw(a.panel, { Position = UDim2.new(1, 14, 0, 0), GroupTransparency = 0 }, 0.25)

	local cached = self.thumbs[plr.UserId]
	a.image.Image = cached or ""
	if not cached then
		task.spawn(function()
			local ok, content = pcall(function()
				return Players:GetUserThumbnailAsync(
					plr.UserId,
					Enum.ThumbnailType.AvatarThumbnail,
					Enum.ThumbnailSize.Size420x420
				)
			end)
			if ok and content then
				self.thumbs[plr.UserId] = content
				if self._avatarToken == tok and a.panel.Visible then
					a.image.Image = content
				end
			end
		end)
	end
end

function Library:hideAvatar()
	if not self.avatar then
		return
	end
	self._avatarToken = (self._avatarToken or 0) + 1
	local tok = self._avatarToken
	local a = self.avatar
	tw(a.panel, { Position = UDim2.new(1, 26, 0, 0), GroupTransparency = 1 }, 0.2)
	task.delay(0.22, function()
		if self._avatarToken == tok then
			a.panel.Visible = false
		end
	end)
end

function Library:Destroy()
	for _, c in ipairs(self.conns) do
		c:Disconnect()
	end
	self.gui:Destroy()
end

