-- dropdown listing the server's players; hovering a name previews the avatar
-- callback(Player or nil, obj)
function Section:addPlayers(title, callback, includeSelf)
	local lib = self.page.library
	if includeSelf == nil then
		includeSelf = true
	end

	local function names(excluding)
		local list = {}
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= excluding and (includeSelf or p ~= LocalPlayer) then
				table.insert(list, p.Name)
			end
		end
		table.sort(list, function(a, b)
			return a:lower() < b:lower()
		end)
		return list
	end

	local function find(name)
		return name and Players:FindFirstChild(name) or nil
	end

	local dropdown
	dropdown = self:_dropdown(title or "Select Player", names(), function(name, obj)
		if callback then
			callback(find(name), obj)
		end
	end, {
		onHover = function(name)
			lib:showAvatar(find(name))
		end,
		onLeave = function()
			lib:hideAvatar()
		end,
	})

	function dropdown:GetPlayer()
		return find(dropdown:Get())
	end

	local function refresh(leaving)
		local before = dropdown:Get()
		dropdown:Refresh(names(leaving))
		if before and dropdown:Get() == nil and callback then
			task.spawn(callback, nil, dropdown) -- selected player left
		end
	end
	lib:_connect(Players.PlayerAdded, function()
		refresh()
	end)
	lib:_connect(Players.PlayerRemoving, function(leaving)
		refresh(leaving)
	end)

	return dropdown
end

-- text that can update in real time:
--   addLabel("static text")
--   addLabel(function() return "FPS: " .. fps end, 0.1)   -- re-evaluated every `interval` seconds
-- supports rich text, e.g. <b>bold</b>
function Section:addLabel(content, interval)
	local lib = self.page.library
	interval = interval or 0.1

	local row = self:_row("Label", 32)
	row.AutomaticSize = Enum.AutomaticSize.Y
	lib:_new("UIPadding", {
		PaddingTop = UDim.new(0, 8),
		PaddingBottom = UDim.new(0, 8),
		PaddingLeft = UDim.new(0, 12),
		PaddingRight = UDim.new(0, 12),
		Parent = row,
	})

	local text = lib:_new("TextLabel", {
		Name = "Text",
		Size = UDim2.new(1, 0, 0, 16),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Text = "",
		TextSize = 13,
		TextWrapped = true,
		RichText = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		_font = "Body",
		_theme = { TextColor3 = "Text" },
		Parent = row,
	})

	local updater
	local elapsed = 0
	local obj = { Instance = row }

	local function evaluate()
		local ok, result = pcall(updater)
		if ok then
			local s = tostring(result)
			if text.Text ~= s then
				text.Text = s
			end
		end
	end

	function obj:Set(value)
		if type(value) == "function" then
			updater = value
			elapsed = 0
			evaluate()
		else
			updater = nil
			text.Text = tostring(value)
		end
	end
	function obj:Get()
		return text.Text
	end

	lib:_connect(RunService.Heartbeat, function(dt)
		if not updater or not lib.visible or not self.page.container.Visible then
			return
		end
		elapsed += dt
		if elapsed >= interval then
			elapsed = 0
			evaluate()
		end
	end)

	obj:Set(content or "")
	return obj
end

