function Section:_dropdown(title, list, callback, opts)
	opts = opts or {}
	local lib = self.page.library
	local items = list or {}
	local selected, open, focused = nil, false, false
	local ITEM_H, GAP = 26, 3

	local holder = lib:_new("Frame", {
		Name = "Dropdown",
		Size = UDim2.new(1, 0, 0, 32),
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		Parent = self.container,
	})

	local header = self:_row("Header", 32, holder)

	local search = lib:_new("TextBox", {
		Name = "Search",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(12, 0),
		Size = UDim2.new(1, -46, 1, 0),
		Text = title,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		ClearTextOnFocus = true,
		_font = "Body",
		_theme = { TextColor3 = "Text" },
		Parent = header,
	})

	local arrow = lib:_new("ImageLabel", {
		Name = "Arrow",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.fromOffset(18, 18),
		BackgroundTransparency = 1,
		Image = ASSET_ARROW,
		_theme = { ImageColor3 = "Accent" },
		Parent = header,
	})

	local arrowHit = lib:_new("TextButton", {
		Name = "ArrowHit",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.new(0, 40, 1, 0),
		BackgroundTransparency = 1,
		Text = "",
		Parent = header,
	})

	local listFrame = lib:_new("Frame", {
		Name = "List",
		Position = UDim2.fromOffset(0, 36),
		Size = UDim2.new(1, 0, 0, 40),
		_theme = { BackgroundColor3 = "Background" },
		Parent = holder,
	}, {
		lib:_corner(7),
		lib:_new("UIStroke", { Thickness = 1, Transparency = 0.6, _theme = { Color = "Stroke" } }),
	})

	local scroll = lib:_new("ScrollingFrame", {
		Name = "Scroll",
		Position = UDim2.fromOffset(4, 4),
		Size = UDim2.new(1, -8, 1, -8),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 2,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		_theme = { ScrollBarImageColor3 = "Accent" },
		Parent = listFrame,
	}, {
		lib:_new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, GAP) }),
	})

	local obj = { Instance = holder }

	local function display()
		if selected ~= nil then
			return title .. ": " .. tostring(selected)
		end
		return title
	end

	local function resize(count)
		if not open then
			return
		end
		local rows = math.clamp(math.max(count, 1), 1, 4)
		local listHeight = rows * ITEM_H + (rows - 1) * GAP + 8
		tw(listFrame, { Size = UDim2.new(1, 0, 0, listHeight) }, 0.25)
		tw(holder, { Size = UDim2.new(1, 0, 0, 36 + listHeight) }, 0.25)
	end

	local setOpen, populate

	local function choose(item, silent)
		selected = item
		search.Text = display()
		setOpen(false)
		if not silent and callback then
			task.spawn(callback, item, obj)
		end
	end

	populate = function(filterText)
		for _, child in ipairs(scroll:GetChildren()) do
			if child:IsA("TextButton") or child:IsA("TextLabel") then
				child:Destroy()
			end
		end

		local f = (filterText or ""):lower()
		local shown = 0
		for _, item in ipairs(items) do
			local text = tostring(item)
			if f == "" or text:lower():find(f, 1, true) then
				shown += 1
				local isSelected = item == selected
				local btn = lib:_new("TextButton", {
					Name = "Item",
					LayoutOrder = shown,
					Size = UDim2.new(1, 0, 0, ITEM_H),
					Text = text,
					TextSize = 12,
					TextXAlignment = Enum.TextXAlignment.Left,
					AutoButtonColor = false,
					_font = "Body",
					Parent = scroll,
					BackgroundColor3 = isSelected and lib.theme.Stroke or lib.theme.Element,
					TextColor3 = isSelected and lib.theme.Accent or lib.theme.Text,
				}, {
					lib:_corner(5),
					lib:_new("UIPadding", { PaddingLeft = UDim.new(0, 8) }),
				})
				btn.MouseEnter:Connect(function()
					tw(btn, { BackgroundColor3 = lib.theme.Stroke }, 0.1)
					if opts.onHover then
						opts.onHover(item)
					end
				end)
				btn.MouseLeave:Connect(function()
					tw(btn, { BackgroundColor3 = item == selected and lib.theme.Stroke or lib.theme.Element }, 0.1)
					if opts.onLeave then
						opts.onLeave()
					end
				end)
				btn.MouseButton1Click:Connect(function()
					choose(item)
				end)
			end
		end

		if shown == 0 then
			lib:_new("TextLabel", {
				Name = "Empty",
				Size = UDim2.new(1, 0, 0, ITEM_H),
				BackgroundTransparency = 1,
				Text = "No results",
				TextSize = 12,
				_font = "Body",
				_theme = { TextColor3 = "SubText" },
				Parent = scroll,
			})
		end

		resize(shown)
	end

	setOpen = function(state)
		open = state
		tw(arrow, { Rotation = state and 180 or 0 }, 0.25)
		if state then
			populate("")
		else
			tw(holder, { Size = UDim2.new(1, 0, 0, 32) }, 0.25)
			if opts.onLeave then
				opts.onLeave()
			end
			search.Text = display()
		end
	end

	arrowHit.MouseButton1Click:Connect(function()
		setOpen(not open)
	end)
	search.Focused:Connect(function()
		focused = true
		if not open then
			setOpen(true)
		end
	end)
	search.FocusLost:Connect(function()
		focused = false
		search.Text = display()
	end)
	search:GetPropertyChangedSignal("Text"):Connect(function()
		if focused then
			populate(search.Text)
		end
	end)

	function obj:Refresh(newList)
		items = newList or {}
		if selected ~= nil and not table.find(items, selected) then
			selected = nil
			search.Text = display()
		end
		if open then
			populate("")
		end
	end
	function obj:Set(item, silent)
		choose(item, silent)
	end
	function obj:Get()
		return selected
	end
	function obj:SetTitle(text)
		title = text
		search.Text = display()
	end

	return obj
end

