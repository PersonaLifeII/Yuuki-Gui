-- Tabs
--------------------------------------------------------------------
function Library:AddTab(name, category, icon)
	category = category and string.upper(category) or nil

	if category and category ~= self._lastCategory then
		self._lastCategory = category
		self._order += 1
		label(self.TabList, {
			Name = "Header_" .. category,
			Size = UDim2.new(1, 0, 0, 22),
			Text = category,
			TextSize = 10,
			Font = FONT_BOLD,
			TextColor3 = Theme.SubText,
			LayoutOrder = self._order,
		})
	end

	self._order += 1
	local button = new("TextButton", {
		Name = name,
		Size = UDim2.new(1, 0, 0, 32),
		BackgroundColor3 = Theme.Accent,
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		Text = "",
		LayoutOrder = self._order,
	}, self.TabList)
	corner(button, 6)

	local iconLabel = label(button, {
		Position = UDim2.new(0, 10, 0, 0),
		Size = UDim2.new(0, 20, 1, 0),
		Text = icon or "•",
		TextSize = 14,
		TextColor3 = Theme.SubText,
		TextXAlignment = Enum.TextXAlignment.Center,
	})
	local title = label(button, {
		Position = UDim2.new(0, 38, 0, 0),
		Size = UDim2.new(1, -44, 1, 0),
		Text = name,
		TextColor3 = Theme.SubText,
	})

	local page = new("ScrollingFrame", {
		Name = name,
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = Theme.Accent,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Visible = false,
	}, self.Pages)

	local function column(xScale, xOffset)
		local col = new("Frame", {
			Position = UDim2.new(xScale, xOffset, 0, 0),
			Size = UDim2.new(0.5, -6, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
		}, page)
		new("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 12)}, col)
		return col
	end

	local tab = setmetatable({
		Library = self,
		Page = page,
		Left = column(0, 0),
		Right = column(0.5, 6),
		Button = button,
		Title = title,
		Icon = iconLabel,
		Elements = {},
	}, Tab)

	button.MouseButton1Click:Connect(function()
		self:SelectTab(tab)
	end)
	button.MouseEnter:Connect(function()
		if self.Selected ~= tab then
			tween(button, {BackgroundTransparency = 0.9})
		end
	end)
	button.MouseLeave:Connect(function()
		if self.Selected ~= tab then
			tween(button, {BackgroundTransparency = 1})
		end
	end)

	table.insert(self.Tabs, tab)
	if not self.Selected then
		self:SelectTab(tab)
	end
	return tab
end

function Library:SelectTab(tab)
	if self.Selected then
		local old = self.Selected
		old.Page.Visible = false
		tween(old.Button, {BackgroundTransparency = 1})
		old.Title.TextColor3 = Theme.SubText
		old.Icon.TextColor3 = Theme.SubText
	end
	self.Selected = tab
	tab.Page.Visible = true
	tween(tab.Button, {BackgroundTransparency = 0.85})
	tab.Title.TextColor3 = Theme.Text
	tab.Icon.TextColor3 = Theme.Accent
end

