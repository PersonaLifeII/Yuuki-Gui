function Library:addPage(title, icon, jp)
	local index = #self.pages + 1
	icon = icon or DEFAULT_ICONS[(index - 1) % #DEFAULT_ICONS + 1]

	local isImage = type(icon) == "number" or (type(icon) == "string" and icon:match("^%d+$") ~= nil)

	local button = self:_new("TextButton", {
		Name = title,
		LayoutOrder = index,
		Size = UDim2.new(1, 0, 0, 38),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		_theme = { BackgroundColor3 = "Accent" },
		Parent = self.pagesList,
	}, { self:_corner(7) })

	local indicator = self:_new("Frame", {
		Name = "Indicator",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.fromOffset(3, 18),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		_theme = { BackgroundColor3 = "Accent" },
		Parent = button,
	}, { self:_corner(3) })

	local iconObj, iconProp
	if isImage then
		iconProp = "ImageColor3"
		iconObj = self:_new("ImageLabel", {
			Name = "Icon",
			BackgroundTransparency = 1,
			Position = UDim2.new(0, 12, 0.5, -8),
			Size = UDim2.fromOffset(16, 16),
			Image = "rbxassetid://" .. tostring(icon),
			Parent = button,
		})
	else
		iconProp = "TextColor3"
		iconObj = self:_new("TextLabel", {
			Name = "Icon",
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(8, 0),
			Size = UDim2.new(0, 24, 1, 0),
			Text = tostring(icon),
			TextSize = 18,
			Font = Enum.Font.GothamBold,
			Parent = button,
		})
	end

	local titleLabel = self:_new("TextLabel", {
		Name = "Title",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(38, jp and 5 or 0),
		Size = jp and UDim2.new(1, -42, 0, 16) or UDim2.new(1, -42, 1, 0),
		Text = title,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		_font = "Body",
		Parent = button,
	})

	if jp then
		self:_new("TextLabel", {
			Name = "Japanese",
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(38, 21),
			Size = UDim2.new(1, -42, 0, 12),
			Text = jp,
			TextSize = 10,
			TextXAlignment = Enum.TextXAlignment.Left,
			Font = Enum.Font.Gotham,
			_theme = { TextColor3 = "SubText" },
			Parent = button,
		})
	end

	local container = self:_new("ScrollingFrame", {
		Name = title,
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 2,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Visible = false,
		_theme = { ScrollBarImageColor3 = "Accent" },
		Parent = self.content,
	}, {
		self:_new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 8) }),
		self:_new("UIPadding", { PaddingRight = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8) }),
	})

	local page = setmetatable({
		library = self,
		button = button,
		indicator = indicator,
		icon = iconObj,
		iconProp = iconProp,
		titleLabel = titleLabel,
		container = container,
		sections = {},
	}, Page)

	table.insert(self.pages, page)
	page:_style(false, false)
	self:_bind(function()
		page:_style(self.current == page, false)
	end)

	button.MouseButton1Click:Connect(function()
		self:SelectPage(page)
	end)
	button.MouseEnter:Connect(function()
		if self.current ~= page then
			tw(button, { BackgroundTransparency = 0.94 }, 0.15)
		end
	end)
	button.MouseLeave:Connect(function()
		if self.current ~= page then
			tw(button, { BackgroundTransparency = 1 }, 0.15)
		end
	end)

	if #self.pages == 1 then
		self:SelectPage(page)
	end

	return page
end

function Page:_style(selected, animate)
	local th = self.library.theme
	local t = animate and 0.2 or 0
	setProps(self.button, { BackgroundTransparency = selected and 0.88 or 1 }, t)
	setProps(self.indicator, { BackgroundTransparency = selected and 0 or 1 }, t)
	setProps(self.titleLabel, { TextColor3 = selected and th.Text or th.SubText }, t)
	setProps(self.icon, { [self.iconProp] = selected and th.Accent or th.SubText }, t)
end

function Library:SelectPage(page)
	if self.current == page then
		return
	end

	if self.current then
		self.current.container.Visible = false
		self.current:_style(false, true)
	end

	self.current = page
	page.container.Visible = true
	page:_style(true, true)

	page.container.Position = UDim2.fromOffset(0, 14)
	tw(page.container, { Position = UDim2.fromOffset(0, 0) }, 0.3)
end

