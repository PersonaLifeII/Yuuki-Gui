--[[
	桜  SAKURA UI  ·  サクラ
	A themeable Roblox UI library (Luau). Default accent: #FFEAF7

	API
	---
	local Library = require(...) / loadstring(...)()
	local UI      = Library.new(title, subtitle?)
	UI:addSettingsPage()                      -- ready-made 設定 page (keybind, theme, fonts, presets)
	local Page    = UI:addPage(title, icon?, japaneseSubtitle?)   -- icon: glyph string ("桜") or asset id
	local Section = Page:addSection(title)

	Section:addButton(title, callback)                         callback(obj)
	Section:addToggle(title, default, callback)                callback(value, obj)
	Section:addSlider(title, default, min, max, callback, step?) callback(value, obj)
	Section:addTextbox(title, default, callback)               callback(text, enterPressed, obj)
	Section:addDropdown(title, list, callback)                 callback(item, obj)
	Section:addKeybind(title, defaultKeyCode, callback, changedCallback)
	Section:addColorPicker(title, defaultColor3, callback)     callback(color3, obj)

	Every element returns an object with :Set(value, silent?) / :Get() / :SetTitle(text)
	(dropdown also has :Refresh(list), button has :SetTitle only).

	Section:addPlayers(title, callback, includeSelf?)           callback(Player or nil, obj)  -- hover = avatar preview
	Section:addLabel(textOrFunction, tip?, interval?)           -- function = updates in real time
	Section:addWheel(title, options, callback)                  callback(result, index, obj)

	TIPS  (hover tooltips)
	local addTip = Library.addTip          -- (also available as UI.addTip)
	addTip[1]("text", "title?")            -- regular tooltip that follows the cursor
	addTip[2](playerOrName?)               -- avatar card on the right of the GUI (no argument = detect the player from the element's text;
	                                       -- a function that returns a Player/name/nil works too, e.g. addTip[2](findMurderer))
	addTip[3](imageAssetId, "message", "title?")   -- image + message card on the right of the GUI
	Any element:  element:addTip(addTip[1]("hi"))   or   element:addTip(1, "hi")   |   element:removeTip()
	Trailing argument:  addButton(title, cb, tip) · addToggle(title, default, cb, tip) · addDropdown(title, list, cb, tip) · addLabel(text, tip)
	Dropdown (tip shows while hovering its items):
	    dropdown:addTip(addTip[1]("for every item"))
	    dropdown:addTip("Sakura", addTip[3](123456, "only for this item"))
	    dropdown:addTip({ Fuji = addTip[1]("..."), Ramen = addTip[3](123456, "...") })

	UI:setSize(w, h) / UI:resetSize()                           -- window is also resizable by dragging its edges
	UI:toggle(force?)          show / hide the window
	UI:Notify(title, text, duration?, callback?)
	UI:setTheme(key, Color3)   keys: Accent, Background, Panel, Element, Stroke, Text, SubText
	UI:setFont(name)           any Enum.Font name
	UI:setToggleKey(KeyCode)
	UI:setPetals(bool)
	UI:Destroy()
]]

