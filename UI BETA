	function obj:SetTitle(text)
		label.Text = text
	end

	input.Focused:Connect(function()
		tw(boxFrame.Stroke, { Color = lib.theme.Accent, Transparency = 0.2 }, 0.15)
	end)
	input.FocusLost:Connect(function(enterPressed)
		tw(boxFrame.Stroke, { Color = lib.theme.Stroke, Transparency = 0.6 }, 0.15)
		if callback then
			task.spawn(callback, input.Text, enterPressed, obj)
		end
	end)

	return obj
end

