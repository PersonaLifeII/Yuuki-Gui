--[[
	桜  SAKURA UI  ·  サクラ
	A themeable Roblox UI library (Luau). Default accent: #BDFFD7

	API
	---
	local Library = require(...) / loadstring(...)()
	local UI      = Library.new(title, subtitle?)
	UI:addSettingsPage()                      -- ready-made 設定 page (keybind, theme, fonts, presets)
	local Page    = UI:addPage(title, icon?, japaneseSubtitle?)   -- icon: glyph string ("桜") or asset id
	local Section = Page:addSection(title)

	Section:addButton(title, callback)                         callback(obj)
	Section:addToggle(title, default, callback)                callback(value, obj)
	Section:addSlider(title, default, min, max, callback, step?) callback(value, obj)
	Section:addTextbox(title, default, callback)               callback(text, enterPressed, obj)
	Section:addDropdown(title, list, callback)                 callback(item, obj)
	Section:addKeybind(title, defaultKeyCode, callback, changedCallback)
	Section:addColorPicker(title, defaultColor3, callback)     callback(color3, obj)

	Every element returns an object with :Set(value, silent?) / :Get() / :SetTitle(text)
	(dropdown also has :Refresh(list), button has :SetTitle only).

	Section:addPlayers(title, callback, includeSelf?)           callback(Player or nil, obj)  -- hover = avatar preview
	Section:addLabel(textOrFunction, interval?)                 -- function = updates in real time
	Section:addWheel(title, options, callback)                  callback(result, index, obj)

	UI:setSize(w, h) / UI:resetSize()                           -- window is also resizable by dragging its edges
	UI:toggle(force?)          show / hide the window
	UI:Notify(title, text, duration?, callback?)
	UI:setTheme(key, Color3)   keys: Accent, Background, Panel, Element, Stroke, Text, SubText
	UI:setFont(name)           any Enum.Font name
	UI:setToggleKey(KeyCode)
	UI:setPetals(bool)
	UI:Destroy()
]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local LocalPlayer = Players.LocalPlayer

local function hex(code)
	code = (code:gsub("#", ""))
	return Color3.fromRGB(
		tonumber(code:sub(1, 2), 16),
		tonumber(code:sub(3, 4), 16),
		tonumber(code:sub(5, 6), 16)
	)
end

local DEFAULT_THEME = {
	Accent = hex("BDFFD7"),
	Background = Color3.fromRGB(13, 15, 17),
	Panel = Color3.fromRGB(20, 24, 26),
	Element = Color3.fromRGB(28, 33, 36),
	Stroke = Color3.fromRGB(52, 64, 60),
	Text = Color3.fromRGB(236, 246, 241),
	SubText = Color3.fromRGB(143, 160, 152),
}

local DEFAULT_ICONS = { "桜", "月", "星", "雪", "風", "火", "水", "花" }

local ASSET_ARROW = "rbxassetid://5012539403"
local ASSET_CHECK = "rbxassetid://5012538259"
local ASSET_CROSS = "rbxassetid://5012538583"

local function tw(obj, props, t, style, dir)
	local tween = TweenService:Create(
		obj,
		TweenInfo.new(t or 0.2, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out),
		props
	)
	tween:Play()
	return tween
end

local function setProps(obj, props, t)
	if t and t > 0 then
		tw(obj, props, t)
	else
		for k, v in pairs(props) do
			obj[k] = v
		end
	end
end

local function getGuiParent()
	local ok, ui = pcall(function()
		return gethui()
	end)
	if ok and ui then
		return ui
	end

	ok = pcall(function()
		local probe = Instance.new("Folder")
		probe.Parent = game:GetService("CoreGui")
		probe:Destroy()
	end)
	if ok then
		return game:GetService("CoreGui")
	end

	return LocalPlayer:WaitForChild("PlayerGui")
end

local function isPress(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch
end

local function isMove(input)
	return input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch
end

local Library = {}
Library.__index = Library
Library.hex = hex

local Page = {}
Page.__index = Page

local Section = {}
Section.__index = Section

--------------------------------------------------------------------------
-- internals
--------------------------------------------------------------------------

function Library:_new(class, props, children)
	local obj = Instance.new(class)
	props = props or {}

	local themeMap = props._theme
	local fontKey = props._font
	props._theme, props._font = nil, nil

	for k, v in pairs(props) do
		obj[k] = v
	end

	if themeMap then
		table.insert(self.themed, { obj = obj, map = themeMap })
		for prop, key in pairs(themeMap) do
			obj[prop] = self.theme[key]
		end
	end

	if fontKey then
		obj.Font = self.fonts[fontKey]
		table.insert(self.fontObjs, { obj = obj, key = fontKey })
	end

	for _, child in ipairs(children or {}) do
		child.Parent = obj
	end

	return obj
end

function Library:_corner(radius)
	return self:_new("UICorner", { CornerRadius = UDim.new(0, radius) })
end

function Library:_connect(signal, fn)
	table.insert(self.conns, signal:Connect(fn))
end

function Library:_bind(fn)
	table.insert(self.binds, fn)
end

function Library:_drag(target, onMove)
	local dragging = false
	self:_connect(target.InputBegan, function(input)
		if isPress(input) then
			dragging = true
			onMove(input.Position)
		end
	end)
	self:_connect(UserInputService.InputChanged, function(input)
		if dragging and isMove(input) then
			onMove(input.Position)
		end
	end)
	self:_connect(UserInputService.InputEnded, function(input)
		if isPress(input) then
			dragging = false
		end
	end)
end

