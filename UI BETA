	local label = self:_label(row, title, -120)

	local keyBtn = lib:_new("TextButton", {
		Name = "Key",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -8, 0.5, 0),
		Size = UDim2.fromOffset(96, 22),
		Text = key and key.Name or "None",
		TextSize = 12,
		AutoButtonColor = false,
		_font = "Title",
		_theme = { BackgroundColor3 = "Background", TextColor3 = "Accent" },
		Parent = row,
	}, { lib:_corner(5) })

	local obj = { Instance = row }

	function obj:Set(newKey, silent)
		key = newKey
		listening = false
		keyBtn.Text = key and key.Name or "None"
		if not silent and changedCallback then
			task.spawn(changedCallback, key, obj)
		end
	end
	function obj:Get()
		return key
	end
	function obj:SetTitle(text)
		label.Text = text
	end

	keyBtn.MouseButton1Click:Connect(function()
		if listening then
			return
		end
		listening = true
		keyBtn.Text = "..."
	end)

	lib:_connect(UserInputService.InputBegan, function(input, processed)
		if listening then
			if input.UserInputType == Enum.UserInputType.Keyboard then
				if input.KeyCode == Enum.KeyCode.Escape then
					obj:Set(nil)
				else
					obj:Set(input.KeyCode)
				end
			end
			return
		end
		if key and not processed and input.KeyCode == key and callback then
			task.spawn(callback, obj)
		end
	end)

	return obj
end

