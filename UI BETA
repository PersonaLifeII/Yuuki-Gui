function Section:_row(name, height, parent)
	local lib = self.page.library
	local row = lib:_new("Frame", {
		Name = name,
		Size = UDim2.new(1, 0, 0, height or 32),
		BackgroundTransparency = 0.05,
		_theme = { BackgroundColor3 = "Element" },
		Parent = parent or self.container,
	}, {
		lib:_corner(7),
		lib:_new("UIStroke", {
			Name = "Stroke",
			Thickness = 1,
			Transparency = 0.7,
			_theme = { Color = "Stroke" },
		}),
	})

	local stroke = row.Stroke
	row.MouseEnter:Connect(function()
		tw(stroke, { Color = lib.theme.Accent, Transparency = 0.4 }, 0.15)
	end)
	row.MouseLeave:Connect(function()
		tw(stroke, { Color = lib.theme.Stroke, Transparency = 0.7 }, 0.15)
	end)

	return row
end

function Section:_label(row, text, widthOffset)
	local lib = self.page.library
	return lib:_new("TextLabel", {
		Name = "Title",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(12, 0),
		Size = UDim2.new(1, widthOffset or -24, 1, 0),
		Text = text,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		_font = "Body",
		_theme = { TextColor3 = "Text" },
		Parent = row,
	})
end

