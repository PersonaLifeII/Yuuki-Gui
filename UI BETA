function Library:Notify(title, text, duration, callback)
	duration = duration or 4

	local wrapper = self:_new("Frame", {
		Size = UDim2.new(1, 0, 0, 60),
		BackgroundTransparency = 1,
		Parent = self.notifyHolder,
	})

	local toast = self:_new("CanvasGroup", {
		Name = "Toast",
		Position = UDim2.new(1, 40, 0, 0),
		Size = UDim2.fromScale(1, 1),
		GroupTransparency = 1,
		_theme = { BackgroundColor3 = "Panel" },
		Parent = wrapper,
	}, {
		self:_corner(8),
		self:_new("Frame", {
			Name = "Bar",
			Size = UDim2.new(0, 3, 1, 0),
			BorderSizePixel = 0,
			_theme = { BackgroundColor3 = "Accent" },
		}),
		self:_new("TextLabel", {
			Name = "Title",
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(14, 7),
			Size = UDim2.new(1, -64, 0, 16),
			Text = tostring(title or "Notification"),
			TextSize = 13,
			TextXAlignment = Enum.TextXAlignment.Left,
			_font = "Title",
			_theme = { TextColor3 = "Accent" },
		}),
		self:_new("TextLabel", {
			Name = "Text",
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(14, 25),
			Size = UDim2.new(1, -64, 0, 28),
			Text = tostring(text or ""),
			TextSize = 12,
			TextWrapped = true,
			TextTruncate = Enum.TextTruncate.AtEnd,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			_font = "Body",
			_theme = { TextColor3 = "SubText" },
		}),
	})

	local progress = self:_new("Frame", {
		Name = "Progress",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, 2),
		BorderSizePixel = 0,
		_theme = { BackgroundColor3 = "Accent" },
		Parent = toast,
	})

	self:_new("Frame", {
		Name = "Outline",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Parent = toast,
	}, {
		self:_corner(8),
		self:_new("UIStroke", {
			Thickness = 2,
			Transparency = 0.6,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
			_theme = { Color = "Accent" },
		}),
	})

	local closed = false
	local function close(result)
		if closed then
			return
		end
		closed = true
		if callback and result ~= nil then
			task.spawn(callback, result)
		end
		tw(toast, { Position = UDim2.new(1, 40, 0, 0), GroupTransparency = 1 }, 0.3)
		task.delay(0.32, function()
			wrapper:Destroy()
		end)
	end

	if callback then
		local accept = self:_new("ImageButton", {
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -34, 0.5, 0),
			Size = UDim2.fromOffset(16, 16),
			Image = ASSET_CHECK,
			_theme = { ImageColor3 = "Accent" },
			Parent = toast,
		})
		local decline = self:_new("ImageButton", {
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -12, 0.5, 0),
			Size = UDim2.fromOffset(16, 16),
			Image = ASSET_CROSS,
			_theme = { ImageColor3 = "SubText" },
			Parent = toast,
		})
		accept.MouseButton1Click:Connect(function()
			close(true)
		end)
		decline.MouseButton1Click:Connect(function()
			close(false)
		end)
	else
		local hit = self:_new("TextButton", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Text = "",
			Parent = toast,
		})
		hit.MouseButton1Click:Connect(function()
			close()
		end)
	end

	tw(toast, { Position = UDim2.new(0, 0, 0, 0), GroupTransparency = 0 }, 0.4, Enum.EasingStyle.Back)
	tw(progress, { Size = UDim2.new(0, 0, 0, 2) }, duration, Enum.EasingStyle.Linear)
	task.delay(duration, function()
		if callback then
			close(false) -- timed out = declined
		else
			close()
		end
	end)
end

