function Tab:AddSection(title, side)
	local parent = (side and string.lower(side) == "right") and self.Right or self.Left

	local frame = new("Frame", {
		Name = title,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Theme.Section,
		BorderSizePixel = 0,
		LayoutOrder = #parent:GetChildren(),
	}, parent)
	corner(frame, 8)
	new("UIStroke", {Color = Theme.Stroke}, frame)
	new("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder}, frame)

	local header = new("TextButton", {
		Size = UDim2.new(1, 0, 0, 36),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		LayoutOrder = 0,
	}, frame)
	label(header, {
		Position = UDim2.new(0, 12, 0, 0),
		Size = UDim2.new(1, -40, 1, 0),
		Text = title,
		Font = FONT_BOLD,
		TextSize = 14,
	})
	local chevron = label(header, {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.new(0, 16, 0, 16),
		Text = "⌄",
		TextSize = 16,
		TextColor3 = Theme.Accent,
		TextXAlignment = Enum.TextXAlignment.Center,
	})

	local content = new("Frame", {
		Name = "Content",
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = 1,
	}, frame)
	new("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 2)}, content)
	new("UIPadding", {
		PaddingLeft = UDim.new(0, 12),
		PaddingRight = UDim.new(0, 12),
		PaddingBottom = UDim.new(0, 10),
	}, content)

	local open = true
	header.MouseButton1Click:Connect(function()
		open = not open
		content.Visible = open
		tween(chevron, {Rotation = open and 0 or -90})
	end)

	return setmetatable({
		Tab = self,
		Content = content,
		_order = 0,
	}, Section)
end

local function register(section, name, frame)
	section._order += 1
	frame.LayoutOrder = section._order
	table.insert(section.Tab.Elements, {name = name, frame = frame})
end

function Section:AddLabel(text)
	local row = new("Frame", {Size = UDim2.new(1, 0, 0, 22), BackgroundTransparency = 1}, self.Content)
	local l = label(row, {Size = UDim2.new(1, 0, 1, 0), Text = text, TextColor3 = Theme.SubText, TextSize = 12})
	register(self, text, row)
	return {SetText = function(_, t) l.Text = t end}
end

function Section:AddToggle(name, default, callback, opts)
	opts = opts or {}
	local height = opts.Description and 42 or 30
	local row = new("Frame", {Size = UDim2.new(1, 0, 0, height), BackgroundTransparency = 1}, self.Content)

	label(row, {
		Position = UDim2.new(0, 0, 0, opts.Description and 5 or 0),
		Size = UDim2.new(1, -110, 0, opts.Description and 18 or 30),
		Text = name,
	})
	if opts.Description then
		label(row, {
			Position = UDim2.new(0, 0, 0, 22),
			Size = UDim2.new(1, -110, 0, 14),
			Text = opts.Description,
			TextSize = 10,
			TextColor3 = Theme.SubText,
		})
	end

	local switch = new("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.new(0, 38, 0, 20),
		BackgroundColor3 = Theme.Off,
		AutoButtonColor = false,
		Text = "",
	}, row)
	corner(switch, 10)
	local knob = new("Frame", {
		Position = UDim2.new(0, 2, 0.5, -8),
		Size = UDim2.new(0, 16, 0, 16),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
	}, switch)
	corner(knob, 8)

	local state = default and true or false
	local obj = {}

	local function render()
		tween(switch, {BackgroundColor3 = state and Theme.Accent or Theme.Off})
		tween(knob, {Position = state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)})
	end
	local function set(value, silent)
		state = value and true or false
		render()
		if callback and not silent then
			task.spawn(callback, state)
		end
	end

	switch.MouseButton1Click:Connect(function()
		set(not state)
	end)
	render()

	-- Optional keybind chip
	if opts.Keybind ~= nil then
		local key = typeof(opts.Keybind) == "EnumItem" and opts.Keybind or nil
		local listening = false
		local chip = new("TextButton", {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -48, 0.5, 0),
			Size = UDim2.new(0, 0, 0, 18),
			AutomaticSize = Enum.AutomaticSize.X,
			BackgroundColor3 = Theme.Row,
			AutoButtonColor = false,
			Font = FONT_BOLD,
			TextSize = 10,
			TextColor3 = Theme.SubText,
			Text = key and key.Name or "—",
		}, row)
		corner(chip, 4)
		new("UIPadding", {PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6)}, chip)

		chip.MouseButton1Click:Connect(function()
			listening = true
			chip.Text = "..."
		end)
		UIS.InputBegan:Connect(function(input, processed)
			if listening then
				if input.UserInputType == Enum.UserInputType.Keyboard then
					listening = false
					key = input.KeyCode ~= Enum.KeyCode.Escape and input.KeyCode or nil
					chip.Text = key and key.Name or "—"
				end
				return
			end
			if processed then return end
			if key and input.KeyCode == key then
				set(not state)
			end
		end)
	end

	function obj:Set(v) set(v) end
	function obj:Get() return state end

	register(self, name, row)
	return obj
end

function Section:AddButton(name, callback)
	local row = new("Frame", {Size = UDim2.new(1, 0, 0, 32), BackgroundTransparency = 1}, self.Content)
	local btn = new("TextButton", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.new(1, 0, 0, 26),
		BackgroundColor3 = Theme.Row,
		AutoButtonColor = false,
		Font = FONT,
		TextSize = 13,
		TextColor3 = Theme.Text,
		Text = name,
	}, row)
	corner(btn, 6)
	btn.MouseEnter:Connect(function() tween(btn, {BackgroundColor3 = Theme.Off}) end)
	btn.MouseLeave:Connect(function() tween(btn, {BackgroundColor3 = Theme.Row}) end)
	btn.MouseButton1Click:Connect(function()
		tween(btn, {BackgroundColor3 = Theme.Accent}, 0.08)
		task.delay(0.12, function() tween(btn, {BackgroundColor3 = Theme.Row}, 0.2) end)
		if callback then task.spawn(callback) end
	end)
	register(self, name, row)
	return btn
end

function Section:AddSlider(name, min, max, default, callback)
	local row = new("Frame", {Size = UDim2.new(1, 0, 0, 48), BackgroundTransparency = 1}, self.Content)
	label(row, {Position = UDim2.new(0, 0, 0, 4), Size = UDim2.new(1, -50, 0, 18), Text = name})
	local valueLabel = label(row, {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 4),
		Size = UDim2.new(0, 50, 0, 18),
		Text = tostring(default or min),
		TextXAlignment = Enum.TextXAlignment.Right,
		TextColor3 = Theme.Accent,
		Font = FONT_BOLD,
	})

	local hit = new("TextButton", {
		Position = UDim2.new(0, 0, 0, 26),
		Size = UDim2.new(1, 0, 0, 18),
		BackgroundTransparency = 1,
		Text = "",
	}, row)
	local bar = new("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.new(1, 0, 0, 6),
		BackgroundColor3 = Theme.Off,
		BorderSizePixel = 0,
	}, hit)
	corner(bar, 3)
	local fill = new("Frame", {
		Size = UDim2.new(0, 0, 1, 0),
		BackgroundColor3 = Theme.Accent,
		BorderSizePixel = 0,
	}, bar)
	corner(fill, 3)

	local value = default or min
	local function setValue(v, silent)
		v = math.clamp(math.floor(v + 0.5), min, max)
		value = v
		valueLabel.Text = tostring(v)
		tween(fill, {Size = UDim2.new((v - min) / (max - min), 0, 1, 0)}, 0.08)
		if callback and not silent then task.spawn(callback, v) end
	end
	setValue(value, true)

	local dragging = false
	local function fromX(x)
		local rel = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
		setValue(min + (max - min) * rel)
	end
	hit.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			fromX(input.Position.X)
		end
	end)
	UIS.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			fromX(input.Position.X)
		end
	end)
	UIS.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	register(self, name, row)
	return {Set = function(_, v) setValue(v) end, Get = function() return value end}
end

function Section:AddDropdown(name, options, default, callback)
	local holder = new("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
	}, self.Content)
	new("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 2)}, holder)

	local current = default or options[1]
	local head = new("TextButton", {
		Size = UDim2.new(1, 0, 0, 28),
		BackgroundColor3 = Theme.Row,
		AutoButtonColor = false,
		Font = FONT,
		TextSize = 13,
		TextColor3 = Theme.Text,
		Text = "",
		LayoutOrder = 0,
	}, holder)
	corner(head, 6)
	label(head, {Position = UDim2.new(0, 10, 0, 0), Size = UDim2.new(0.5, 0, 1, 0), Text = name})
	local valueLabel = label(head, {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -10, 0, 0),
		Size = UDim2.new(0.5, -10, 1, 0),
		Text = tostring(current),
		TextXAlignment = Enum.TextXAlignment.Right,
		TextColor3 = Theme.Accent,
	})

	local list = new("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Visible = false,
		LayoutOrder = 1,
	}, holder)
	new("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 2)}, list)

	for _, option in ipairs(options) do
		local item = new("TextButton", {
			Size = UDim2.new(1, 0, 0, 24),
			BackgroundColor3 = Theme.Off,
			AutoButtonColor = false,
			Font = FONT,
			TextSize = 12,
			TextColor3 = Theme.Text,
			Text = tostring(option),
		}, list)
		corner(item, 5)
		item.MouseButton1Click:Connect(function()
			current = option
			valueLabel.Text = tostring(option)
			list.Visible = false
			if callback then task.spawn(callback, option) end
		end)
	end
	head.MouseButton1Click:Connect(function()
		list.Visible = not list.Visible
	end)

	register(self, name, holder)
	return {Get = function() return current end}
end

return Library
