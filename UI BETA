	})

	lib:_addOccluder(listFrame) -- element tips underneath the open list must not trigger

	local scroll = lib:_new("ScrollingFrame", {
		Name = "Scroll",
		Position = UDim2.fromOffset(4, 4),
		Size = UDim2.new(1, -8, 1, -8),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 2,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		_theme = { ScrollBarImageColor3 = "Accent" },
		Parent = listFrame,
	}, {
		lib:_new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, GAP) }),
	})

	local obj = { Instance = holder }

	local function display()
		if selected ~= nil then
			return title .. ": " .. tostring(selected)
		end
		return title
	end

	local function resize(count)
		if not open then
			return
		end
		local rows = math.clamp(math.max(count, 1), 1, 4)
		local listHeight = rows * ITEM_H + (rows - 1) * GAP + 8
		tw(listFrame, { Size = UDim2.new(1, 0, 0, listHeight) }, 0.25)
		tw(holder, { Size = UDim2.new(1, 0, 0, 36 + listHeight) }, 0.25)
	end

	local setOpen, populate

	local function choose(item, silent)
		selected = item
		search.Text = display()
		setOpen(false)
		if not silent and callback then
			task.spawn(callback, item, obj)
		end
	end

	populate = function(filterText)
		hoverBtn = nil
		lib:_tipClear(scroll)
		for _, child in ipairs(scroll:GetChildren()) do
			if child:IsA("TextButton") or child:IsA("TextLabel") then
				child:Destroy()
			end
		end

		local f = (filterText or ""):lower()
		local shown = 0
		for _, item in ipairs(items) do
			local text = tostring(item)
			if f == "" or text:lower():find(f, 1, true) then
				shown += 1
				local isSelected = item == selected
				local btn = lib:_new("TextButton", {
					Name = "Item",
					LayoutOrder = shown,
					Size = UDim2.new(1, 0, 0, ITEM_H),
					Text = text,
					TextSize = 12,
					TextXAlignment = Enum.TextXAlignment.Left,
					AutoButtonColor = false,
					_font = "Body",
					Parent = scroll,
					BackgroundColor3 = isSelected and lib.theme.Stroke or lib.theme.Element,
					TextColor3 = isSelected and lib.theme.Accent or lib.theme.Text,
				}, {
					lib:_corner(5),
					lib:_new("UIPadding", { PaddingLeft = UDim.new(0, 8) }),
				})
				btn.MouseEnter:Connect(function()
					tw(btn, { BackgroundColor3 = lib.theme.Stroke }, 0.1)
					if opts.onHover then
						opts.onHover(item)
					end
					hoverBtn = btn
					local tip = tipMap[item] or defaultTip
					if tip then
						lib:_tipSet(scroll, tip, text)
					end
				end)
				btn.MouseLeave:Connect(function()
					tw(btn, { BackgroundColor3 = item == selected and lib.theme.Stroke or lib.theme.Element }, 0.1)
					if opts.onLeave then
						opts.onLeave()
					end
					if hoverBtn == btn then
						hoverBtn = nil
						lib:_tipClear(scroll)
					end
				end)
				btn.MouseButton1Click:Connect(function()
					choose(item)
				end)
			end
		end

		if shown == 0 then
			lib:_new("TextLabel", {
				Name = "Empty",
				Size = UDim2.new(1, 0, 0, ITEM_H),
				BackgroundTransparency = 1,
				Text = "No results",
				TextSize = 12,
				_font = "Body",
				_theme = { TextColor3 = "SubText" },
				Parent = scroll,
			})
		end

		resize(shown)
	end

	setOpen = function(state)
		open = state
		tw(arrow, { Rotation = state and 180 or 0 }, 0.25)
		if state then
			populate("")
		else
			tw(holder, { Size = UDim2.new(1, 0, 0, 32) }, 0.25)
			hoverBtn = nil
			lib:_tipClear(scroll)
			if opts.onLeave then
				opts.onLeave()
			end
			search.Text = display()
		end
	end

	arrowHit.MouseButton1Click:Connect(function()
		setOpen(not open)
	end)
	search.Focused:Connect(function()
		focused = true
		if not open then
			setOpen(true)
		end
	end)
	search.FocusLost:Connect(function()
		focused = false
		search.Text = display()
	end)
	search:GetPropertyChangedSignal("Text"):Connect(function()
		if focused then
			populate(search.Text)
		end
	end)

	-- tips shown while hovering the items of the open list:
	--   dropdown:addTip(addTip[1]("every item"))                      -- all items
	--   dropdown:addTip("Sakura", addTip[3](123456, "just this one"))   -- one item
	--   dropdown:addTip({ Fuji = addTip[1]("..."), Ramen = ... })       -- several items
	-- a function argument receives the hovered item, e.g. addTip[1](function(item) return "Pick " .. item end)
	function obj:addTip(first, ...)
		local second = ...
		if isTip(second) then
			tipMap[first] = second
		elseif type(first) == "table" and not isTip(first) then
			for item, t in pairs(first) do
				local tip = toTip(t)
				if tip then
					tipMap[item] = tip
				end
			end
		else
			local tip = toTip(first, ...)
			if tip then
				defaultTip = tip
			else
				warn("[SakuraUI] addTip expects addTip[1], addTip[2] or addTip[3]")
			end
		end
		return obj
	end
	function obj:removeTip()
		defaultTip = nil
		table.clear(tipMap)
		hoverBtn = nil
		lib:_tipClear(scroll)
		return obj
	end

	function obj:Refresh(newList)
		items = newList or {}
		if selected ~= nil and not table.find(items, selected) then
			selected = nil
			search.Text = display()
		end
		if open then
			populate("")
		end
	end
	function obj:Set(item, silent)
		choose(item, silent)
	end
	function obj:Get()
		return selected
	end
	function obj:SetTitle(text)
		title = text
		search.Text = display()
	end

	return obj
end

