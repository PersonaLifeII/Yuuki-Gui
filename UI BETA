function Section:addSlider(title, default, min, max, callback, step)
	local lib = self.page.library
	min = min or 0
	max = max or 100
	step = step or 1
	local value = math.clamp(default or min, min, max)

	local row = self:_row("Slider", 42)
	local label = self:_label(row, title, -80)
	label.Position = UDim2.fromOffset(12, 7) -- same line as the value box, close to the bar
	label.Size = UDim2.new(1, -80, 0, 16)

	local box = lib:_new("TextBox", {
		Name = "Value",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 7),
		Size = UDim2.fromOffset(56, 16),
		BackgroundTransparency = 1,
		Text = tostring(value),
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Right,
		ClearTextOnFocus = false,
		_font = "Title",
		_theme = { TextColor3 = "Accent" },
		Parent = row,
	})

	local bar = lib:_new("Frame", {
		Name = "Bar",
		Position = UDim2.new(0, 12, 0, 30),
		Size = UDim2.new(1, -24, 0, 5),
		BorderSizePixel = 0,
		_theme = { BackgroundColor3 = "Background" },
		Parent = row,
	}, { lib:_corner(3) })

	local fill = lib:_new("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(0, 1),
		BorderSizePixel = 0,
		_theme = { BackgroundColor3 = "Accent" },
		Parent = bar,
	}, {
		lib:_corner(3),
		lib:_new("Frame", {
			Name = "Knob",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(1, 0.5),
			Size = UDim2.fromOffset(12, 12),
			BorderSizePixel = 0,
			_theme = { BackgroundColor3 = "Text" },
		}, {
			lib:_corner(6),
			lib:_new("UIStroke", { Thickness = 2, _theme = { Color = "Accent" } }),
		}),
	})

	local obj = { Instance = row }

	local function snap(v)
		v = math.clamp(math.floor((v - min) / step + 0.5) * step + min, min, max)
		return math.floor(v * 10000 + 0.5) / 10000
	end

	local function setValue(v, silent, instant)
		v = snap(v)
		local changed = v ~= value
		value = v
		box.Text = tostring(v)
		local pct = (max == min) and 0 or (v - min) / (max - min)
		setProps(fill, { Size = UDim2.fromScale(pct, 1) }, instant and 0 or 0.08)
		if changed and not silent and callback then
			task.spawn(callback, value, obj)
		end
	end

	function obj:Set(v, silent)
		setValue(v, silent)
	end
	function obj:Get()
		return value
	end
	function obj:SetTitle(text)
		label.Text = text
	end

	setValue(value, true, true)

	-- dragging: start on the lower part of the row so the label/value box stay clickable
	local dragging = false
	local hit = lib:_new("TextButton", {
		Name = "Hit",
		Position = UDim2.fromOffset(0, 22),
		Size = UDim2.new(1, 0, 1, -22),
		BackgroundTransparency = 1,
		Text = "",
		Parent = row,
	})
	local function fromPos(pos)
		local p = math.clamp((pos.X - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1)
		setValue(min + (max - min) * p)
	end
	lib:_connect(hit.InputBegan, function(input)
		if isPress(input) then
			dragging = true
			fromPos(input.Position)
		end
	end)
	lib:_connect(UserInputService.InputChanged, function(input)
		if dragging and isMove(input) then
			fromPos(input.Position)
		end
	end)
	lib:_connect(UserInputService.InputEnded, function(input)
		if isPress(input) then
			dragging = false
		end
	end)

	box.FocusLost:Connect(function()
		local n = tonumber(box.Text)
		if n then
			setValue(n)
		else
			box.Text = tostring(value)
		end
	end)

	if callback then
		task.defer(callback, value, obj) -- initial value
	end

	return obj
end

