function Library:toggle(force)
	local show = force
	if show == nil then
		show = not self.visible
	end
	if show == self.visible then
		return
	end

	self.visible = show
	self._tok = (self._tok or 0) + 1
	local tok = self._tok

	if show then
		self.root.Visible = true
		tw(self.scale, { Scale = 1 }, 0.3, Enum.EasingStyle.Back)
		tw(self.window, { GroupTransparency = 0 }, 0.25)
	else
		tw(self.scale, { Scale = 0.92 }, 0.2)
		tw(self.window, { GroupTransparency = 1 }, 0.2)
		task.delay(0.22, function()
			if self._tok == tok and not self.visible then
				self.root.Visible = false
			end
		end)
	end
end

function Library:setToggleKey(key)
	self.toggleKey = key
end

function Library:setPetals(state)
	self.petalsEnabled = state and true or false
	self.petalsFrame.Visible = self.petalsEnabled
end

function Library:setTheme(key, color)
	self.theme[key] = color
	for i = #self.themed, 1, -1 do
		local entry = self.themed[i]
		if not entry.obj.Parent then
			table.remove(self.themed, i)
		else
			for prop, k in pairs(entry.map) do
				if k == key then
					tw(entry.obj, { [prop] = color }, 0.25)
				end
			end
		end
	end
	for _, fn in ipairs(self.binds) do
		fn()
	end
end

function Library:setFont(name)
	local ok, font = pcall(function()
		return Enum.Font[name]
	end)
	if not ok or not font then
		return
	end
	self.fonts.Body = font
	for _, entry in ipairs(self.fontObjs) do
		if entry.key == "Body" and entry.obj.Parent then
			entry.obj.Font = font
		end
	end
end

-- drag any edge / corner of the window to resize it
function Library:_makeResizer()
	local root = self.root
	local MIN_W, MIN_H, MAX_W, MAX_H = 470, 330, 1000, 760

	-- name, position, size, dx, dy
	local defs = {
		{ "Right", UDim2.new(1, -3, 0, 12), UDim2.new(0, 8, 1, -24), 1, 0 },
		{ "Left", UDim2.new(0, -5, 0, 12), UDim2.new(0, 8, 1, -24), -1, 0 },
		{ "Bottom", UDim2.new(0, 12, 1, -3), UDim2.new(1, -24, 0, 8), 0, 1 },
		{ "Top", UDim2.new(0, 12, 0, -5), UDim2.new(1, -24, 0, 8), 0, -1 },
		{ "BottomRight", UDim2.new(1, -9, 1, -9), UDim2.fromOffset(18, 18), 1, 1 },
		{ "BottomLeft", UDim2.new(0, -9, 1, -9), UDim2.fromOffset(18, 18), -1, 1 },
		{ "TopRight", UDim2.new(1, -9, 0, -9), UDim2.fromOffset(18, 18), 1, -1 },
		{ "TopLeft", UDim2.new(0, -9, 0, -9), UDim2.fromOffset(18, 18), -1, -1 },
	}

	local active

	for _, d in ipairs(defs) do
		local handle = self:_new("Frame", {
			Name = "Resize" .. d[1],
			Position = d[2],
			Size = d[3],
			BackgroundTransparency = 1,
			Active = true,
			Parent = root,
		})
		local glow = self:_new("Frame", {
			Name = "Glow",
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			_theme = { BackgroundColor3 = "Accent" },
			Parent = handle,
		}, { self:_corner(99) })

		handle.MouseEnter:Connect(function()
			if not active then
				tw(glow, { BackgroundTransparency = 0.6 }, 0.12)
			end
		end)
		handle.MouseLeave:Connect(function()
			if not active or active.glow ~= glow then
				tw(glow, { BackgroundTransparency = 1 }, 0.15)
			end
		end)
		handle.InputBegan:Connect(function(input)
			if isPress(input) then
				active = {
					glow = glow,
					dx = d[4],
					dy = d[5],
					mouse = input.Position,
					w = root.Size.X.Offset,
					h = root.Size.Y.Offset,
					pos = root.Position,
				}
				glow.BackgroundTransparency = 0.4
			end
		end)
	end

	self:_connect(UserInputService.InputChanged, function(input)
		if not active or not isMove(input) then
			return
		end
		local delta = input.Position - active.mouse
		local w = active.dx ~= 0 and math.clamp(active.w + active.dx * delta.X, MIN_W, MAX_W) or active.w
		local h = active.dy ~= 0 and math.clamp(active.h + active.dy * delta.Y, MIN_H, MAX_H) or active.h
		root.Size = UDim2.fromOffset(w, h)
		-- root is center-anchored, so shift it by half the size change to keep the opposite edge fixed
		root.Position = UDim2.new(
			active.pos.X.Scale,
			active.pos.X.Offset + active.dx * (w - active.w) / 2,
			active.pos.Y.Scale,
			active.pos.Y.Offset + active.dy * (h - active.h) / 2
		)
	end)

	self:_connect(UserInputService.InputEnded, function(input)
		if active and isPress(input) then
			tw(active.glow, { BackgroundTransparency = 1 }, 0.2)
			active = nil
		end
	end)
end

