function Section:addToggle(title, default, callback)
	local lib = self.page.library
	local active = default == true

	local row = self:_row("Toggle", 32)
	local label = self:_label(row, title, -70)

	local pill = lib:_new("Frame", {
		Name = "Pill",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.fromOffset(38, 18),
		BorderSizePixel = 0,
		Parent = row,
	}, { lib:_corner(9) })

	local knob = lib:_new("Frame", {
		Name = "Knob",
		AnchorPoint = Vector2.new(0, 0.5),
		Size = UDim2.fromOffset(12, 12),
		BorderSizePixel = 0,
		Parent = pill,
	}, { lib:_corner(6) })

	local hit = lib:_new("TextButton", {
		Name = "Hit",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		Parent = row,
	})

	local obj = { Instance = row }

	local function render(animate)
		local th = lib.theme
		local t = animate and 0.2 or 0
		setProps(pill, { BackgroundColor3 = active and th.Accent or th.Background }, t)
		setProps(knob, {
			Position = active and UDim2.new(1, -15, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
			BackgroundColor3 = active and th.Background or th.SubText,
		}, t)
	end

	function obj:Set(value, silent)
		active = value and true or false
		render(true)
		if not silent and callback then
			task.spawn(callback, active, obj)
		end
	end
	function obj:Get()
		return active
	end
	function obj:SetTitle(text)
		label.Text = text
	end

	render(false)
	lib:_bind(function()
		render(false)
	end)

	hit.MouseButton1Click:Connect(function()
		obj:Set(not active)
	end)

	if callback then
		task.defer(callback, active, obj) -- initial value
	end

	return obj
end

