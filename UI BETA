-- tip engine -------------------------------------------------------------------

function Library:_tipDeactivate()
	local cur = self._tip
	self._tip = nil
	self._tipToken = (self._tipToken or 0) + 1 -- cancels pending lookups
	if not cur then
		return
	end
	if cur.mode == 1 then
		self:_hideTooltip()
	elseif cur.mode == 2 then
		self:hideAvatar()
	elseif cur.mode == 3 then
		self:hideInfo()
	end
end

function Library:_tipClear(owner)
	local cur = self._tip
	if cur and (owner == nil or cur.owner == owner) then
		self:_tipDeactivate()
	end
end

-- owner: whatever is hovered (an element entry, a dropdown's list…)
-- ctx:   the hovered element's text (used for auto-detecting players / passed to function arguments)
function Library:_tipSet(owner, tip, ctx, polled)
	local mode, args = tip.mode, tip.args

	-- work out what would be shown, and a signature so unchanged content isn't re-triggered
	local sig, target, a1, a2, a3
	if mode == 1 then
		a1, a2 = resolveArg(args[1], ctx), resolveArg(args[2], ctx)
		if a1 ~= nil then
			sig = "1|" .. tostring(a1) .. "|" .. tostring(a2)
		end
	elseif mode == 2 then
		target = self:_playerTarget(args[1], ctx)
		if target ~= nil then
			if typeof(target) == "Instance" then
				sig = "2|p" .. tostring(target.UserId)
			else
				sig = "2|n" .. tostring(target):lower()
			end
		end
	elseif mode == 3 then
		a1, a2, a3 = resolveArg(args[1], ctx), resolveArg(args[2], ctx), resolveArg(args[3], ctx)
		sig = "3|" .. tostring(a1) .. "|" .. tostring(a2) .. "|" .. tostring(a3)
	end

	local cur = self._tip
	if cur and cur.owner == owner and cur.sig == sig then
		return
	end
	if cur then
		self:_tipDeactivate()
	end
	if not sig then
		return
	end

	self._tipToken = (self._tipToken or 0) + 1
	local tok = self._tipToken
	self._tip = { owner = owner, sig = sig, polled = polled, mode = mode }

	if mode == 1 then
		self:_showTooltip(tostring(a1), a2)
	elseif mode == 2 then
		task.spawn(function()
			local user = self:_userFrom(target)
			if user and self._tipToken == tok then
				self:showAvatar(user)
			end
		end)
	else
		self:showInfo(a1, a2, a3)
	end
end

-- runs every frame: finds the hovered element and shows / hides its tip
function Library:_tipStep()
	if not self.visible then
		if self._tip then
			self:_tipDeactivate()
		end
		return
	end

	local pos = mousePos()
	if self._tip and self._tip.mode == 1 then
		self:_tipPlace(pos)
	end

	if #self.tipTargets == 0 or not UserInputService.MouseEnabled then
		return
	end

	local hovered
	if not UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
		local blocked = false
		for i = #self.tipOccluders, 1, -1 do
			local occ = self.tipOccluders[i]
			if not occ.Parent then
				table.remove(self.tipOccluders, i)
			elseif not blocked and pointIn(occ, pos) and shownAt(occ, pos) then
				blocked = true
			end
		end

		if not blocked then
			for i = #self.tipTargets, 1, -1 do
				local e = self.tipTargets[i]
				if not e.gui.Parent then
					table.remove(self.tipTargets, i)
				elseif not hovered and pointIn(e.gui, pos) and shownAt(e.gui, pos) then
					hovered = e
				end
			end
		end
	end

	if hovered then
		self:_tipSet(hovered, hovered.tip, hovered.getText and hovered.getText() or nil, true)
	elseif self._tip and self._tip.polled then
		self:_tipDeactivate()
	end
end

function Library:Destroy()
	for _, c in ipairs(self.conns) do
		c:Disconnect()
	end
	self.gui:Destroy()
end

